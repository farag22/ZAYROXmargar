# انسخ هذا الملف إلى .env ثم ضع قيم مشروعك في Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Settings → Database → Connection string (URI) — Transaction pooler port 6543
# إذا كانت كلمة المرور تبدأ بـ @ اكتبها %40 بدلاً من @
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:%40YOUR-PASSWORD@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
OWNER_OPEN_ID=
VODAFONE_CASH_NUMBER=
